<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>SlimDXNet</AssemblyName>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Authors />
		<Company />
		<Copyright>Copyright ©  2013</Copyright>
		<Description>C# / Windows Forms wrapper for the SlimDX library</Description>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<RootNamespace>SlimDXNet</RootNamespace>
		<TargetFramework>net6.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<DefineConstants>TRACE;DEBUG</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<OutputPath>$(BaseOutputPath)$(Configuration)</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="AssimpNet">
			<HintPath>Include\AssimpNet.dll</HintPath>
		</Reference>
		<Reference Include="SlimDX">
			<HintPath>Include\SlimDX.dll</HintPath>
		</Reference>
		<Reference Include="SpriteTextRenderer">
			<HintPath>Include\SpriteTextRenderer.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>
